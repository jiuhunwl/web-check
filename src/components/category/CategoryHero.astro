---
import ScanForm from '@components/form/ScanForm.astro';
import type { Category, CategoryId } from '@/data/categories';

interface Props {
  category: CategoryId;
  info: Category;
  count: number;
}

const { category, info, count } = Astro.props;
const [lead, accent, tail] = info.heading;
---

<section class="hero">
  <h1>
    <span data-i18n={`category:${category}.heading.0`}>{lead}</span>
    <em data-i18n={`category:${category}.heading.1`}>{accent}</em>
    <span data-i18n={`category:${category}.heading.2`}>{tail}</span>
  </h1>
  <p class="tagline" data-i18n={`category:${category}.tagline`}>
    {info.tagline}
  </p>
  <ScanForm
    tool={category}
    label={`Enter a URL to run all ${count} checks`}
    labelI18n="Enter a URL to run all {count} checks"
    labelVars={{ count }}
  />
</section>

<style lang="scss">
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;

    h1 {
      margin: 0;
      font-size: clamp(2.5rem, 7vw, 4rem);
      line-height: 1.05;
      letter-spacing: -0.02em;
      text-wrap: balance;

      em {
        color: var(--primary);
      }
    }

    .tagline {
      margin: 0;
      max-width: 42rem;
      font-size: 1.25rem;
      line-height: 1.5;
      color: var(--text-color-secondary);
    }
  }
</style>
