---
import PageLayout from '@layouts/Page.astro';
import Main from '../client/main.tsx';
import '../client/styles/index.css';

/**
 * Static app shell.
 *
 * EdgeOne Makers serves this file for unmatched paths (the SPA fallback
 * `"rewrites": [{ "source": "/*", "destination": "/index.html" }]` in
 * edgeone.json), so the React router in `client/main.tsx` can resolve
 * /check/<url> and /<tool>/<url> on the client.
 *
 * Those two routes are `prerender = false` upstream and need an SSR runtime.
 * Makers Cloud Functions run Node 20, while Astro 7 requires Node >= 22.12,
 * so prerendering + client-side routing is the only way to run them there.
 */
export const prerender = true;
---

<script is:inline>
  // The marketing homepage now lives at /home; self-hosted installs land on
  // the scan form, which is also what upstream does via a meta refresh.
  if (window.location.pathname === '/') window.location.replace('/check');
</script>

<PageLayout title="Web Check" description="All-in-one OSINT tool for analysing any website">
  <Main client:only="react" />
</PageLayout>

<style is:global>
  body {
    --page-width: min(94vw, 2200px);
    --main-padding: 2rem 0;
  }
</style>
